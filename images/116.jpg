.wp-block-pullquote{font-size: 1.5em;line-height: 1.6;}</style> <script type="text/javascript" src="https://auto-bel.org/wp-includes/js/jquery/jquery.min.js?ver=3.7.1" id="jquery-core-js"></script> <link rel="https://api.w.org/" href="https://auto-bel.org/wp-json/" /> <style id="uagb-style-conditional-extension">@media (min-width: 1025px){body .uag-hide-desktop.uagb-google-map__wrap,body .uag-hide-desktop{display:none !important}}@media (min-width: 768px) and (max-width: 1024px){body .uag-hide-tab.uagb-google-map__wrap,body .uag-hide-tab{display:none !important}}@media (max-width: 767px){body .uag-hide-mob.uagb-google-map__wrap,body .uag-hide-mob{display:none !important}}</style><style id="uagb-style-frontend-1979">.uag-blocks-common-selector{z-index:var(--z-index-desktop) !important}@media (max-width: 976px){.uag-blocks-common-selector{z-index:var(--z-index-tablet) !important}}@media (max-width: 767px){.uag-blocks-common-selector{z-index:var(--z-index-mobile) !important}}</style><style type="text/css" id="wp-custom-css">/* блоки рекламы в тексте */
.item-img-square {
    float: left;
    margin-right: 20px;
}
.item-container__small {
    display: flex;
    flex-direction: row;
    padding: 12px 0;
    border-top: solid 1px #e5e5e5;
    border-bottom: solid 1px #e5e5e5;
}
.item-container__small:last-child {
    margin-right: 0;
	  margin-bottom: 1.5rem;
}
.item-stat {
    display: flex;
    flex-direction: row;
    align-items: center;
}
.item-stat .stat__data__time, .item-stat .stat__data__view {
    display: flex;
    flex-direction: row;
    align-items: center;
    font-size: 0.8rem;
    color: #909090;
    margin-right: 24px;
}
.icon__time {
    background-position: 1px 2px;
    margin-left: -3px;
}
.icons-about-article {
    display: inline-block;
    width: 16px;
    height: 16px;
    background: url(https://24l7-news.com/templates/bbc/img/icons-about-article.svg) no-repeat;
        background-position-x: 0%;
        background-position-y: 0%;
    margin-right: 0.3rem;
}
.icon__views {
    background-position: 1px -13px;
}
.item-title__small {
    color: #000;
    font-weight: bold;
    font-size: 20px;
    line-height: 1.375rem;
    text-decoration: none;
}
.item-title__small-2 {
     color: #333;
     text-decoration: none;
     display: block;
     margin-top: 15px;
     font-size: 16px;
     line-height: 20px;
}
@media (min-width: 320px) and (max-width: 619px) {

  .item-title__small {
    font-size: 1rem;
    line-height: 1.285rem;
  }
.item-img-square {
    width: 100px;
    height: 100px;
}
}

/* Перенес из настроек темы, там не меняется */

.item-car .type-car-position li b {
    color: #000000;
}
.item-car .type-car-position li span {
    color: #000000;
}
.fileupload-progress .ui-widget-header {
    border: 1px solid #ff600a;
}
.contact_form_capcha{
    display:inline-block
}
.contact-form input.verify {
    height: 30px;
}
.carproducers_list {
    margin: 10px 0px 0px 0px !important;
}
.wp-pagenavi a, .wp-pagenavi .page-numbers, .wp-pagenavi .current, .wp-pagenavi .nextpostslink, .wp-pagenavi .prevpostslink {
    font-size: 12px;
    line-height: 14px;
    height: 14px;
}
.wp-pagenavi {
margin-bottom: 0px;
}
.tmm-view-mode.item-grid article {
margin-bottom: 10px;
}
body {
font-family: 'Arial', sans-serif !important;
}
.widget_contacts li {
font-family: 'Arial', sans-serif;
}
.navigation > ul > li > a {
font-family: 'Arial', sans-serif;
}
h1, h2, h3, h4, h5, h6 {
font-family: 'Arial', sans-serif;
}
.tile-pin-list_catalog {
    padding: 5px 0 20px;
}
.tile-pin-list {
    margin-bottom: 10px;
}
.tile-pin-list_catalog .tile-pin {
    display: inline-block;
    width: 25%;
    margin: 0.5em -0.4em 0.5em 0;
    vertical-align: top;
}
.tile-pin {
    display: block;
    position: relative;
    text-align: left;
    white-space: nowrap;
}
.tile-pin-list_catalog .tile-pin__text {
    width: 100%;
    margin-left: -60px;
    padding-left: 60px;
    padding-right: 5%;
    white-space: normal;
    word-wrap: break-word;
    -moz-box-sizing: border-box;
    -webkit-box-sizing: border-box;
    -moz-box-sizing: border-box;
    box-sizing: border-box;
}
.tile-pin__text {
    font-size: 19px;
    font-size: 1.357em;
    display: inline-block;
    vertical-align: middle;
    color: #202020;
}
.tile-pin {
    text-align: left;
    white-space: nowrap;
}
.tile-pin-list_catalog .tile-pin__pic {
    width: 60px;
    margin-right: 3%;
}
.tile-pin__pic {
    display: inline-block;
    margin-right: 6%;
    vertical-align: middle;
}
img {
    vertical-align: top;
    border: 0;
    -ms-interpolation-mode: bicubic;
}
@media screen and (max-width: 735px) {
.tile-pin__text {
    display: none;
}
}
/* Боковой поиск */
.boxed-entry fieldset {
    display: block;
}
#sidebar .boxed-entry p {
    margin-left: 0;
    margin-right: 5%;
    width: 46%;
}
.boxed-entry fieldset p {
    display: inline-block;
    width: 40%;
    margin-bottom: 8px;
    margin-right: 30px;
    vertical-align: top;
}
#sidebar .boxed-entry fieldset > p:nth-child(2n) {
    margin-right: 0;
}
.adv_car_p {
    width: 100% !important;
}
/* Статьи на главной */
.widget .table-entry h4 {
white-space: normal;
}
/* Таблицы */
th, td {
    border: 1px solid black;
    padding: 5px;
}
.name-blok {
    font-family: 'Arial', sans-serif;
    font-size: 28px;
    color: #000000;
    line-height: 1.6;
    font-weight: 400;
}
blok1, blok2, blok3, blok4, blok5, blok6 {
    font-family: 'Arial', sans-serif;
    margin-bottom: 15px;
    line-height: 1.35;
}
.blok1 {
   font-size: 32px;
   color: #000000;
   font-weight: 400;
}
.blok3 {
   font-size: 22px;
   color: #000000;
   font-weight: 400;
}
.blok6 {
   font-size: 16px;
   color: #000000;
   font-weight: 400;
}
.blok4 {
   color: #ff600a;
   font-weight: 400;
}
.header-page-title-blok1 {
   font-size: 32px;
   font-weight: 400;
   line-height: 1;
   margin-bottom: 0;
   color: #fff;
   text-transform: uppercase;
}
.name-article {
color: rgb(255, 96, 10);
font-size: 18px;
}
p#reply-title {font-size: 24px; line-height: 30px; font-weight: bold;}

/* Реклама юриста / блок голосования  */
.linked_box {
    border-top: 2px solid #0066b3;
}
.linked_box {
    border-right: 2px solid #0066b3;
}
.linked_box {
    border-bottom: 2px solid #0066b3;
	
}
.linked_box {
    border-left: 2px solid #0066b3;
}
.linked_box {
    line-height: 20px;
    font-size: 17px;
}
.linked_box {
    padding: 20px;
    margin: 0 0 30px;
    background: rgba(41,128,185,.1);
    clear: both;
    /*float: left; в рут теме включить */
    box-shadow: 2px 2px 7px -2px rgba(0, 0, 0, 0.4);
}

.wp-polls .Buttons {
	background-color: #999; 
}

/* всплывающие блоки рекламы */
.block_bottom {
height: 100px;
width: 320px;
}
.block_left {
height: 400px;
width: 240px;
}
.block {
animation:anim 15s;
position: fixed;
background-color: #f2f3f4;
z-index: 100;
top: auto;
left: 0;
right: auto;
bottom: 0px;
}
.block__close1 {
bottom: 100%;
right: 0;
text-decoration: none;
cursor: pointer;
line-height: 1;
margin: 0;
padding: 0;
text-align: center;
height: 20px;
font-weight: normal;
font-style: normal;
color: #e6f0ff;
background: #646464;
top: 0;
bottom: auto;
z-index: 100;
}
@keyframes anim {
from {left:-100%;}
to {left:0;}
}

/* Contextual Related Posts */
.crp_related  {
	border: 1px solid #aaa;
	padding: 10px;
	margin-bottom: 1em;
	width: auto;
	display: table;
	font-size: 95%;
}</style></head><body class="error404"> <input id="toggle-main-nav" class="toggle-main-nav" type="checkbox" /><div class="wrapper"><div class="wrapper-inner"><div id="fb-root"></div><div class="header alternate"><div class="logo-bar sticky-bar"><div class="container"><div class="row"><div class="col-xs-8 col-md-3"><div class="logo"> <a title="Авторынок, автомалиновка и авито для Белоруссии" href="https://auto-bel.org/"><img				src="https://auto-bel.org/wp-content/uploads/2016/03/mw_joomla_logo.png" alt="Авторынок, автомалиновка и авито для Белоруссии" /></a></div></div><div class="col-xs-4 col-md-9"> <label for="toggle-main-nav" class="label-toggle-main-nav"><div class="menu-icon-container"><div class="menu-icon"><div class="menu-global menu-top"></div><div class="menu-global menu-middle"></div><div class="menu-global menu-bottom"></div></div></div> </label><nav id="navigation" class="navigation clearfix"><ul id="menu-menu" class="menu"><li id="menu-item-869" class="menu-item menu-item-type-post_type menu-item-object-page menu-item-home menu-item-869"><a href="https://auto-bel.org/">Главная</a></li><li id="menu-item-870" class="menu-item menu-item-type-post_type menu-item-object-page menu-item-870"><a href="https://auto-bel.org/inventory/">Выбор автомобиля</a></li><li id="menu-item-1876" class="menu-item menu-item-type-post_type menu-item-object-page menu-item-has-children menu-item-1876"><a href="https://auto-bel.org/blog/">Статьи</a><ul class="sub-menu"><li id="menu-item-2411" class="menu-item menu-item-type-taxonomy menu-item-object-category menu-item-2411"><a href="https://auto-bel.org/ob-avtomobilyax/">Об автомобилях</a></li><li id="menu-item-2011" class="menu-item menu-item-type-taxonomy menu-item-object-category menu-item-has-children menu-item-2011"><a href="https://auto-bel.org/obsluzhivanie/">Обслуживание</a><ul class="sub-menu"><li id="menu-item-2374" class="menu-item menu-item-type-taxonomy menu-item-object-category menu-item-2374"><a href="https://auto-bel.org/obsluzhivanie/bezopasnost/">Безопасность</a></li><li id="menu-item-2375" class="menu-item menu-item-type-taxonomy menu-item-object-category menu-item-2375"><a href="https://auto-bel.org/obsluzhivanie/dvigatel/">Двигатель</a></li><li id="menu-item-2376" class="menu-item menu-item-type-taxonomy menu-item-object-category menu-item-2376"><a href="https://auto-bel.org/obsluzhivanie/zapchasti/">Запчасти</a></li><li id="menu-item-2377" class="menu-item menu-item-type-taxonomy menu-item-object-category menu-item-2377"><a href="https://auto-bel.org/obsluzhivanie/kolesa/">Колеса</a></li><li id="menu-item-2379" class="menu-item menu-item-type-taxonomy menu-item-object-category menu-item-2379"><a href="https://auto-bel.org/obsluzhivanie/podveska/">Подвеска</a></li><li id="menu-item-2380" class="menu-item menu-item-type-taxonomy menu-item-object-category menu-item-2380"><a href="https://auto-bel.org/obsluzhivanie/salon/">Салон</a></li><li id="menu-item-2381" class="menu-item menu-item-type-taxonomy menu-item-object-category menu-item-2381"><a href="https://auto-bel.org/obsluzhivanie/toplivo/">Топливо</a></li><li id="menu-item-2382" class="menu-item menu-item-type-taxonomy menu-item-object-category menu-item-2382"><a href="https://auto-bel.org/obsluzhivanie/transmissiya/">Трансмиссия</a></li><li id="menu-item-2383" class="menu-item menu-item-type-taxonomy menu-item-object-category menu-item-2383"><a href="https://auto-bel.org/obsluzhivanie/elektrika/">Электрика</a></li></ul></li><li id="menu-item-3452" class="menu-item menu-item-type-taxonomy menu-item-object-category menu-item-3452"><a href="https://auto-bel.org/kody-regionov-rossii/">Коды регионов России</a></li><li id="menu-item-2399" class="menu-item menu-item-type-taxonomy menu-item-object-category menu-item-2399"><a href="https://auto-bel.org/shtrafy/">Штрафы</a></li></ul></li><li id="menu-item-873" class="menu-item menu-item-type-post_type menu-item-object-page menu-item-has-children menu-item-873"><a href="https://auto-bel.org/sell/">Добавить объявление</a><ul class="sub-menu"><li id="menu-item-1538" class="menu-item menu-item-type-post_type menu-item-object-page menu-item-1538"><a href="https://auto-bel.org/user-profile/">Профиль</a></li><li id="menu-item-1539" class="menu-item menu-item-type-post_type menu-item-object-page menu-item-1539"><a href="https://auto-bel.org/user-cars/">Мои автомобили</a></li></ul></li></ul></nav></div></div></div></div></div><div class="container"><div class="row"><div class="col-xs-12"></div></div></div><div id="content" class="no_sidebar"><div class="container"><div class="row"><main id="main" class="col-xs-12 has-content"><div class="error-404"> <noscript><img src="https://auto-bel.org/wp-content/themes/cardealer/images/mac.png" alt="404" /></noscript><img class="lazyload" src='data:image/svg+xml,%3Csvg%20xmlns=%22http://www.w3.org/2000/svg%22%20viewBox=%220%200%20210%20140%22%3E%3C/svg%3E' data-src="https://auto-bel.org/wp-content/themes/cardealer/images/mac.png" alt="404" /><div class="e404"><h1>404</h1><div class="title-error">Страница не найдена</div><p>К сожалению, запрашиваемая Вами страница была перемещена или удалена</p> <a href="https://auto-bel.org/" class="button orange">Вернуться на главную страницу!</a></div></div></main></div></div></div><footer id="footer"><div class="container"><div class="row"><div class="col-md-3"><div id="text-2" class="widget widget_text"><div class="widget-title blok3">О нас</div><div class="textwidget"><p class="white"> Белорусский авторынок .</p><p>Регистрируйтесь и добавляйте объявления о продаже автомобилей.</p><p>Мы продаем б/у легковые и грузовые машины из Беларуси, а так же свежепригнанные автомобили из Германии.</p><p>Обмен авто на авто в Беларуси на выгодных условиях.</p></div></div></div><div class="col-md-3"><div id="text-4" class="widget widget_text"><div class="widget-title blok3">Купить авто</div><div class="textwidget"><p>Купить легковой или грузовой автомобиль с пробегом, не затрачивая много времени, сил и нервов на его поиски, — возможно.</p><p>Мы поможем выбрать то авто с пробегом, которое будет соответствовать всем вашим требованиям, пожеланиям и капризам.</p><p>Выбери свое авто из Белоруссии!</p></div></div></div><div class="col-md-3"><div class="widget widget_contacts"><div class="widget-title blok3">Контакты</div><ul class="contacts-list"><li class="icon-email"> <a href="mailto:support@auto-bel.org">support@auto-bel.org</a></li><li><ul class="social-icons"><li class="rss"> <a title="rss" href="https://auto-bel.org/feed/"> <i class="icon-rss"></i> </a></li></ul></li></ul></div><div id="text-3" class="widget widget_text"><div class="textwidget"><p>Администрация не несёт ответственности за любую информацию, размещенную пользователями на страницах сайта Авто Бел.</p></div></div></div><div class="col-md-3"><div id="text-5" class="widget widget_text"><div class="widget-title blok3">Внимание!</div><div class="textwidget"><p>Все покупки на территории Беларуси между гражданами осуществляются исключительно в белорусских рублях.</p><p>Цена в иностранной валюте (в случае ее наличия в объявлении граждан) указана справочно.</p></div></div></div></div><div class="row"><div class="col-xs-12"><div class="adjective clearfix"><p class="copyright">Copyright &copy; 2009. Автомобили в Беларуси. Все права защищены.</p></div></div></div></div></footer></div></div> <noscript><style>.lazyload{display:none;}</style></noscript><script data-noptimize="1">window.lazySizesConfig=window.lazySizesConfig||{};window.lazySizesConfig.loadMode=1;</script><script async data-noptimize="1" src='https://auto-bel.org/wp-content/plugins/autoptimize/classes/external/js/lazysizes.min.js?ao_version=3.1.11'></script><script type="text/javascript" id="tmm_theme-js-extra">var tmm_l10n = {"site_url":"https:\/\/auto-bel.org","allow_watch_list":"1","sticky_nav_mobile":"0","any":"\u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435","added_to_compare":"\u041e\u0431\u044a\u044f\u0432\u043b\u0435\u043d\